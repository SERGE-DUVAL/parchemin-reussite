<%
  // locals attendus: idSuffix, isDiplome, labelLines (array de strings)
%>
<div class="medal">
  <svg viewBox="0 0 80 100" class="medal-svg">
    <defs>
      <linearGradient id="medalGrad-<%= idSuffix %>" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#f3d98b"/>
        <stop offset="100%" stop-color="#8a6200"/>
      </linearGradient>
    </defs>
    <polygon points="18,55 6,95 30,82" fill="#8a1f2b"/>
    <polygon points="62,55 74,95 50,82" fill="#8a1f2b"/>
    <circle cx="40" cy="40" r="34" fill="url(#medalGrad-<%= idSuffix %>)" stroke="#7a5a05" stroke-width="2.5"/>
    <circle cx="40" cy="40" r="27" fill="none" stroke="#fffaea" stroke-width="1" opacity="0.6"/>
    <% if (isDiplome) { %>
      <polygon points="40.0,14.0 46.5,31.1 64.7,32.0 50.5,43.4 55.3,61.0 40.0,51.0 24.7,61.0 29.5,43.4 15.3,32.0 33.5,31.1" fill="#fffaea"/>
    <% } else { %>
      <ellipse cx="40.0" cy="11.0" rx="3" ry="7" fill="#fffaea" opacity="0.9"/>
      <ellipse cx="54.5" cy="14.9" rx="3" ry="7" transform="rotate(30 54.5 14.9)" fill="#fffaea" opacity="0.9"/>
      <ellipse cx="65.1" cy="25.5" rx="3" ry="7" transform="rotate(60 65.1 25.5)" fill="#fffaea" opacity="0.9"/>
      <ellipse cx="69.0" cy="40.0" rx="3" ry="7" transform="rotate(90 69.0 40.0)" fill="#fffaea" opacity="0.9"/>
      <ellipse cx="65.1" cy="54.5" rx="3" ry="7" transform="rotate(120 65.1 54.5)" fill="#fffaea" opacity="0.9"/>
      <ellipse cx="54.5" cy="65.1" rx="3" ry="7" transform="rotate(150 54.5 65.1)" fill="#fffaea" opacity="0.9"/>
      <ellipse cx="40.0" cy="69.0" rx="3" ry="7" transform="rotate(180 40.0 69.0)" fill="#fffaea" opacity="0.9"/>
      <ellipse cx="25.5" cy="65.1" rx="3" ry="7" transform="rotate(210 25.5 65.1)" fill="#fffaea" opacity="0.9"/>
      <ellipse cx="14.9" cy="54.5" rx="3" ry="7" transform="rotate(240 14.9 54.5)" fill="#fffaea" opacity="0.9"/>
      <ellipse cx="11.0" cy="40.0" rx="3" ry="7" transform="rotate(270 11.0 40.0)" fill="#fffaea" opacity="0.9"/>
      <ellipse cx="14.9" cy="25.5" rx="3" ry="7" transform="rotate(300 14.9 25.5)" fill="#fffaea" opacity="0.9"/>
      <ellipse cx="25.5" cy="14.9" rx="3" ry="7" transform="rotate(330 25.5 14.9)" fill="#fffaea" opacity="0.9"/>
    <% } %>
  </svg>
  <div class="medal-label">
    <% labelLines.forEach(function (line) { %><span><%= line %></span><% }); %>
  </div>
</div>

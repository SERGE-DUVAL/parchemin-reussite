<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Connexion admin — Famille Tepomo</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="login-wrap">
    <div style="font-family:'Playfair Display',serif; font-size:1.4rem; margin-bottom:20px; color:#2b2114;">
      Famille Tepomo — Administration
    </div>
    <div class="card">
      <% if (error) { %>
        <div class="error-msg"><%= error %></div>
      <% } %>
      <form class="stacked" method="POST" action="/admin/login">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" autofocus required
          style="width:100%; padding:9px 12px; border:1px solid #e4d9bd; border-radius:6px; margin-bottom:16px;" />
        <button type="submit" class="btn" style="width:100%;">Se connecter</button>
      </form>
    </div>
  </div>
</body>
</html>

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Famille Tepomo — Parchemins de Reussite</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Cormorant+Garamond:ital@0;1&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at top, #3a2c17, #1c1408 75%);
      font-family: 'Cormorant Garamond', serif;
      color: #f3e6c4;
      text-align: center;
      padding: 20px;
    }
    .wrap { max-width: 560px; }
    .emblem {
      width: 84px; height: 84px; margin: 0 auto 20px;
      border: 2px solid #d4af37; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Playfair Display', serif; font-size: 1.6rem; color: #d4af37;
      box-shadow: 0 0 0 4px #1c1408, 0 0 0 5px #d4af37;
    }
    h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2.1rem;
      letter-spacing: 1px;
      color: #f3e6c4;
      margin: 0 0 6px;
    }
    p.slogan {
      color: #d4af37;
      font-style: italic;
      font-size: 1.15rem;
      margin: 0 0 32px;
    }
    a.btn {
      display: inline-block;
      border: 1px solid #d4af37;
      color: #d4af37;
      text-decoration: none;
      padding: 12px 28px;
      border-radius: 4px;
      font-size: 1rem;
      letter-spacing: 0.5px;
      transition: 0.2s;
    }
    a.btn:hover { background: #d4af37; color: #1c1408; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="emblem">FT</div>
    <h1>Famille Tepomo</h1>
    <p class="slogan">&laquo; Amour et Fraternite &raquo;</p>
    <a class="btn" href="/admin">Acceder a l'administration</a>
  </div>
</body>
</html>

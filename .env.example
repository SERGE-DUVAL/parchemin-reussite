PORT=3000

# Genere ce hash avec: npm run hash-password -- "TonMotDePasse"
ADMIN_PASSWORD_HASH=

# Chaine aleatoire longue, differente en production
SESSION_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Cree un Blob store depuis le dashboard Vercel (Storage > Create Database >
# Blob), connecte-le a ton projet, puis copie le token affiche ici. En local,
# tu peux aussi utiliser "vercel env pull" pour le recuperer automatiquement.
BLOB_READ_WRITE_TOKEN=
